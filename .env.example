# Copy to .env (gitignored) and fill in. Nano Foundry runs without all of these;
# each one turns a panel from "not configured" into the live thing.
# See docs/credentials.md for where each comes from.

# Tiger Cloud / Timescale — the event hypertable behind the live panel.
# export DATABASE_URL='postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require'

# SerpApi — the citation trail on every catalogue card. Held server-side.
# export SERPAPI_KEY='...'

# Vultr — provisioning the host with ./deploy/bring-up.sh --vultr
# export VULTR_API_KEY='...'

# Snowflake — only needed for `npm run snowflake:export -- --load`
# export SNOWFLAKE_ACCOUNT='...'
# export SNOWFLAKE_USERNAME='...'
# export SNOWFLAKE_PASSWORD='...'
# export SNOWFLAKE_DATABASE='...'
# export SNOWFLAKE_SCHEMA='...'

# Gemini — optional. Set on a deployed box so every visitor can use the
# natural-language screens without pasting a key; the browser never sees it.
# Left unset, each browser pastes its own key on the bench screen, as before.
# https://aistudio.google.com/apikey
# export GEMINI_API_KEY='...'
